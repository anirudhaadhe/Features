<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OData" Version="9.3.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\products.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Application\**\*.cs;Domain\**\*.cs;Infrastructure\**\*.cs" />
    <None Include=".github\copilot-instructions.md" />
    <ProjectReference Include="Application\Features.Application.csproj" />
    <ProjectReference Include="Domain\Features.Domain.csproj" />
    <ProjectReference Include="Infrastructure\Features.Infrastructure.csproj" />
  </ItemGroup>

</Project>
