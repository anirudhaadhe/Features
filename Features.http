@Features_HostAddress = http://localhost:5275

GET {{Features_HostAddress}}/weatherforecast/
Accept: application/json

###

GET {{Features_HostAddress}}/odata/$metadata
Accept: application/xml

###

GET {{Features_HostAddress}}/odata/Products
Accept: application/json

###

GET {{Features_HostAddress}}/odata/Products?$filter=Price%20gt%2050&$orderby=Price%20desc&$select=Id,Name,Price&$count=true&$top=10
Accept: application/json

