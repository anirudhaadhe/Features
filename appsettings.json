{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EventInfrastructure": {
    "HandlerAssemblyNames": [
      "Features"
    ],
    "MaxRetryAttempts": 2,
    "RetryDelay": "00:00:00.250"
  },
  "Notifications": {
    "Enabled": true,
    "DomainEventMappings": {
      "Features.Domain.Products.ProductSampleDataSeededEvent": {
        "Category": "SampleData",
        "Message": "Sample product data was loaded into memory."
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "OutputCache": {
    "InstanceName": "Features:",
    "Policies": {
      "WeatherForecast": {
        "CacheKeyPrefix": "weatherforecast:",
        "DurationSeconds": 60
      },
      "Products": {
        "CacheKeyPrefix": "products:",
        "DurationSeconds": 300,
        "CacheTag": "products"
      }
    }
  },
  "AllowedHosts": "*"
}
